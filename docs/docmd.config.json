{
  "title": "Dolphin",
  "url": "https://hyperlab-sh.github.io/dolphin",
  "src": "docs",
  "out": "site",
  "engine": "js",
  "layout": {
    "spa": true,
    "header": { "enabled": true },
    "sidebar": { "collapsible": true, "defaultCollapsed": false },
    "optionsMenu": {
      "position": "sidebar-top",
      "components": { "search": true, "themeSwitch": true }
    },
    "footer": {
      "style": "minimal",
      "content": "Dolphin, a pluggable multiplexer client.",
      "branding": true
    }
  },
  "theme": { "name": "default", "appearance": "system", "codeHighlight": true },
  "minify": true,
  "autoTitleFromH1": true,
  "copyCode": true,
  "pageNavigation": true,
  "navigation": [
    { "title": "Overview", "path": "/", "icon": "home" },
    { "title": "Architecture", "path": "/architecture/", "icon": "layers" },
    { "title": "Backends", "path": "/backends/", "icon": "plug" },
    { "title": "GitHub", "path": "https://github.com/hyperlab-sh/dolphin", "icon": "github", "external": true }
  ],
  "plugins": {
    "seo": { "defaultDescription": "Dolphin: a pluggable client for terminal agent multiplexers, built on Husk." }
  }
}
